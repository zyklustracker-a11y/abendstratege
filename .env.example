# Optionale Alternative zu src/lib/firebase-config.ts.
# Wer die Werte nicht im Quelltext stehen haben will, kopiert diese Datei nach
# .env und trägt sie hier ein – sie haben dann Vorrang.
#
# Achtung: Diese Werte sind NICHT geheim. Sie landen ohnehin im ausgelieferten
# JavaScript. Geschützt wird das Konto durch firestore.rules und die Liste der
# erlaubten Domains in Firebase.
#
# Geheim bleiben müssen ausschließlich:
#   - der private VAPID-Schlüssel        -> GitHub-Secret VAPID_PRIVATE_KEY
#   - das Firebase-Dienstkonto (JSON)    -> GitHub-Secret FIREBASE_SERVICE_ACCOUNT
# Beide gehören nie in eine Datei im Repo.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_VAPID_PUBLIC_KEY=
