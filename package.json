{
  "name": "der-abendstratege",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "icons": "node scripts/make-icons.mjs",
    "test": "node scripts/test-schedule.mjs && node --experimental-strip-types --disable-warning=ExperimentalWarning scripts/test-week.mjs && npm run test:rules",
    "test:rules": "firebase emulators:exec --only firestore --project abendstratege-rules-test \"node scripts/test-rules.mjs\""
  },
  "dependencies": {
    "firebase": "^12.16.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "firebase-tools": "^15.24.0",
    "typescript": "^7.0.2",
    "vite": "^8.1.5"
  }
}
